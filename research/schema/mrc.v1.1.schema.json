{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VNAB extractive QA (SQuAD with metadata), v1.1",
  "type": "object",
  "required": [
    "id",
    "question",
    "context",
    "answers",
    "group_id",
    "province",
    "type",
    "source_doc",
    "article_clause",
    "context_origin",
    "answerable",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "object",
      "required": [
        "text",
        "answer_start"
      ],
      "properties": {
        "text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_start": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "province": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8_ambiguous",
        "T8_out_of_scope"
      ]
    },
    "source_doc": {
      "type": [
        "string",
        "null"
      ]
    },
    "article_clause": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_origin": {
      "enum": [
        "legal_original",
        "mapping"
      ]
    },
    "answerable": {
      "const": true
    },
    "review_status": {
      "enum": [
        "pending",
        "verified",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
