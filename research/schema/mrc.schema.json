{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VNAB extractive QA (SQuAD)",
  "type": "object",
  "required": [
    "id",
    "question",
    "context",
    "answers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "object",
      "required": [
        "text",
        "answer_start"
      ],
      "properties": {
        "text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_start": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
